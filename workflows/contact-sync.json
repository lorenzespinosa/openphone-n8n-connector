        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"firstName\": \"{{ $json.resolvedName.split(' ')[0] }}\",\n  \"lastName\": \"{{ $json.resolvedName.split(' ').slice(1).join(' ') }}\"\n}",
        "options": {}
      },
      "id": "d4e5f6a7-4444-4ddd-eeee-000000000008",
      "name": "HTTP: Update in OpenPhone",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
