      "id": "d4e5f6a7-4444-4ddd-eeee-000000000003",
      "name": "HTTP: Get CRM Contacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 450]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Merge and compare contacts from both sources\n// This node receives data from both HTTP nodes via a Merge node\nconst item = $input.item.json;\nreturn item;"
      },
      "id": "d4e5f6a7-4444-4ddd-eeee-000000000040",
      "name": "Passthrough",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "jsCode": "// Compare OpenPhone contacts vs CRM contacts and find mismatches\nconst opContacts = $('HTTP: Get OpenPhone Contacts').first().json.data || [];\nconst crmContacts = $('HTTP: Get CRM Contacts').first().json.data || [];\n\n// Normalize phone numbers for comparison\nfunction normalizePhone(phone) {\n  if (!phone) return '';\n  return phone.replace(/[^\\d+]/g, '');\n}\n\n// Build lookup maps\nconst crmByPhone = {};\nfor (const c of crmContacts) {\n  const phone = normalizePhone(c.phone || c.phoneNumber || '');\n  if (phone) crmByPhone[phone] = c;\n}\n\nconst opByPhone = {};\nfor (const c of opContacts) {\n  const phones = c.phoneNumbers || [{ value: c.phone }];\n  for (const p of phones) {\n    const phone = normalizePhone(p.value || p);\n    if (phone) opByPhone[phone] = c;\n  }\n}\n\nconst results = [];\n\n// Find contacts in OpenPhone but not in CRM (new)\nfor (const [phone, opContact] of Object.entries(opByPhone)) {\n  if (!crmByPhone[phone]) {\n    results.push({\n      json: {\n        action: 'create_in_crm',\n        phone,\n        name: opContact.firstName ? `${opContact.firstName} ${opContact.lastName || ''}`.trim() : opContact.name || 'Unknown',\n        email: opContact.email || opContact.emails?.[0]?.value || null,\n        source: 'openphone'\n      }\n    });\n  }\n}\n\n// Find contacts updated in CRM that need sync to OpenPhone\nfor (const [phone, crmContact] of Object.entries(crmByPhone)) {\n  if (opByPhone[phone]) {\n    const opContact = opByPhone[phone];\n    const crmName = crmContact.name || `${crmContact.firstName || ''} ${crmContact.lastName || ''}`.trim();\n    const opName = opContact.name || `${opContact.firstName || ''} ${opContact.lastName || ''}`.trim();\n    \n    if (crmName !== opName) {\n      results.push({\n        json: {\n          action: 'update_in_openphone',\n          phone,\n          crmName,\n          opName,\n          resolvedName: crmName,\n          resolution: 'crm_wins',\n          openphoneContactId: opContact.id || null,\n          source: 'crm'\n        }\n      });\n    }\n  }\n}\n\nif (results.length === 0) {\n  return [{ json: { action: 'no_changes', message: 'All contacts are in sync' } }];\n}\n\nreturn results;"
      },
      "id": "d4e5f6a7-4444-4ddd-eeee-000000000004",
      "name": "Compare & Find Mismatches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
