{
  "name": "SMS Auto-Responder",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "openphone-incoming-sms",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000001",
      "name": "Webhook: Incoming SMS",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "openphone-incoming-sms"
    },
    {
      "parameters": {
        "jsCode": "// Check for STOP/UNSUBSCRIBE keywords (TCPA compliance)\nconst event = $input.first().json;\n\nconst messageBody = (event.data?.body || event.body || '').trim();\nconst senderNumber = event.data?.from || event.from || '+15555550100';\nconst recipientNumber = event.data?.to || event.to || '+15555550200';\nconst messageId = event.data?.id || event.id || 'msg_unknown';\nconst timestamp = event.data?.createdAt || event.createdAt || new Date().toISOString();\n\n// TCPA opt-out keywords\nconst optOutKeywords = ['STOP', 'UNSUBSCRIBE', 'CANCEL', 'END', 'QUIT', 'OPT OUT', 'OPTOUT'];\nconst isOptOut = optOutKeywords.some(kw => messageBody.toUpperCase().includes(kw));\n\n// Check business hours: Mon-Sat 8AM-7PM ET\nconst msgTime = new Date(timestamp);\nconst etOptions = { timeZone: 'America/New_York', hour: 'numeric', weekday: 'short', hour12: false };\nconst etParts = new Intl.DateTimeFormat('en-US', etOptions).formatToParts(msgTime);\nconst hour = parseInt(etParts.find(p => p.type === 'hour').value);\nconst weekday = etParts.find(p => p.type === 'weekday').value;\nconst isBusinessDay = !['Sun'].includes(weekday);\nconst isBusinessHours = hour >= 8 && hour < 19;\nconst withinBusinessHours = isBusinessDay && isBusinessHours;\n\nreturn [{\n  json: {\n    messageBody,\n    senderNumber,\n    recipientNumber,\n    messageId,\n    timestamp,\n    isOptOut,\n    withinBusinessHours\n  }\n}];"
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000002",
      "name": "Check STOP Keywords & Hours",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isOptOut }}",
              "value2": true
            }
          ]
        }
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000003",
      "name": "IF: STOP/Opt-Out",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/YOUR_BASE_ID/OptOutList",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_AIRTABLE_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"fields\": {\n    \"PhoneNumber\": \"{{ $json.senderNumber }}\",\n    \"OptOutDate\": \"{{ new Date().toISOString() }}\",\n    \"Keyword\": \"{{ $json.messageBody }}\",\n    \"Status\": \"Opted Out\"\n  }\n}",
        "options": {}
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000004",
      "name": "Update Opt-Out List",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 150]
    },
    {
      "parameters": {
        "jsCode": "// Do NOT respond to opt-out messages — TCPA requirement\nreturn [{\n  json: {\n    action: 'opt_out_recorded',\n    senderNumber: $input.first().json.senderNumber,\n    note: 'No response sent per TCPA compliance'\n  }\n}];"
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000005",
      "name": "Do NOT Respond",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 150]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.withinBusinessHours }}",
              "value2": true
            }
          ]
        }
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000006",
      "name": "IF: Business Hours",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_OPENAI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Classify the following text message into one of these categories: appointment_request, case_status, general_inquiry. Respond with ONLY the category name.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $('Check STOP Keywords & Hours').first().json.messageBody }}\"\n    }\n  ],\n  \"max_tokens\": 20\n}",
        "options": {}
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000007",
      "name": "AI: Classify Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 350]
    },
    {
      "parameters": {
        "jsCode": "// After hours auto-reply template\nconst data = $('Check STOP Keywords & Hours').first().json;\nreturn [{\n  json: {\n    to: data.senderNumber,\n    from: data.recipientNumber,\n    body: 'Thank you for reaching out to Greenfield & Associates. Our office is currently closed. Business hours are Mon-Sat 8AM-7PM ET. We will respond on the next business day.',\n    intent: 'after_hours',\n    messageId: data.messageId\n  }\n}];"
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000008",
      "name": "After-Hours Auto-Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 550]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.choices?.[0]?.message?.content?.trim() }}",
                    "value2": "appointment_request"
                  }
                ]
              },
              "renameOutput": "Appointment"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.choices?.[0]?.message?.content?.trim() }}",
                    "value2": "case_status"
                  }
                ]
              },
              "renameOutput": "Case Status"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.choices?.[0]?.message?.content?.trim() }}",
                    "value2": "general_inquiry"
                  }
                ]
              },
              "renameOutput": "General"
            }
          ]
        }
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000009",
      "name": "Switch: Intent Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1340, 350]
    },
    {
      "parameters": {
        "jsCode": "// Appointment request template\nconst data = $('Check STOP Keywords & Hours').first().json;\nreturn [{\n  json: {\n    to: data.senderNumber,\n    from: data.recipientNumber,\n    body: 'Thanks for reaching out to Greenfield & Associates! We\\'d be happy to schedule a consultation. Could you share your preferred date and time? Our team will confirm availability.',\n    intent: 'appointment_request',\n    messageId: data.messageId\n  }\n}];"
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000010",
      "name": "Template: Appointment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "jsCode": "// Case status template\nconst data = $('Check STOP Keywords & Hours').first().json;\nreturn [{\n  json: {\n    to: data.senderNumber,\n    from: data.recipientNumber,\n    body: 'Thank you for contacting Greenfield & Associates about your case. A member of our team will review your file and follow up with an update shortly.',\n    intent: 'case_status',\n    messageId: data.messageId\n  }\n}];"
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000011",
      "name": "Template: Case Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 400]
    },
    {
      "parameters": {
        "jsCode": "// General inquiry template\nconst data = $('Check STOP Keywords & Hours').first().json;\nreturn [{\n  json: {\n    to: data.senderNumber,\n    from: data.recipientNumber,\n    body: 'Thank you for contacting Greenfield & Associates. We\\'ve received your message and a team member will get back to you shortly.',\n    intent: 'general_inquiry',\n    messageId: data.messageId\n  }\n}];"
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000012",
      "name": "Template: General Inquiry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 600]
    },
    {
      "parameters": {
        "formTitle": "Approve Outbound SMS",
        "formDescription": "Review and approve the auto-response before sending.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Recipient",
              "fieldType": "text",
              "requiredField": true
