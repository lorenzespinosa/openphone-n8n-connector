          ]
        }
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000013",
      "name": "Human Approval Gate",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2,
      "position": [1780, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.Approve }}",
              "value2": "Yes"
            }
          ]
        }
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000014",
      "name": "IF: Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2000, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openphone.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_OPENPHONE_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"{{ $json.from }}\",\n  \"to\": [\"{{ $json.to }}\"],\n  \"content\": \"{{ $json.body }}\"\n}",
        "options": {}
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000015",
      "name": "HTTP: Send SMS via OpenPhone",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2220, 300]
    },
