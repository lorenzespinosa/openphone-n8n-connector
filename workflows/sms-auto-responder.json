        "jsonBody": "={\n  \"fields\": {\n    \"Workflow\": \"SMS Auto-Responder\",\n    \"Action\": \"{{ $json.action || 'SMS Response' }}\",\n    \"SenderNumber\": \"{{ $('Check STOP Keywords & Hours').first().json.senderNumber }}\",\n    \"Intent\": \"{{ $json.intent || 'n/a' }}\",\n    \"Timestamp\": \"{{ new Date().toISOString() }}\",\n    \"Status\": \"Completed\"\n  }\n}",
        "options": {}
      },
